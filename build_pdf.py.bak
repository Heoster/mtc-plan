F.append(Paragraph(
    "The club operates <b>two parallel doors</b>. This is deliberate: a selection process is "
    "necessary to keep project teams small enough to be taught properly, but it must never "
    "become a device for excluding students from learning.", st_body))

doors = [
    [Paragraph("Open Track \u2014 no selection at all", st_th),
