F.append(Paragraph("D.1 &nbsp; The five stages of Core Track selection", st_h1))
F.append(Paragraph("Conducted once a year in April, and a short mid-year intake in October "
                   "for Class VI and new admissions.", st_sub))

stages = [
    [Paragraph("Stage", st_th), Paragraph("What happens", st_th), Paragraph("What is being judged", st_th),
     Paragraph("Weight", st_th)],
    [Paragraph("<b>1</b><br/><font size=7>Open Call</font>", st_tdc),
     Paragraph("A notice on the school board and a Google Form. The applicant states class, "
               "preferred squad, why they wish to join, and anything they have already made "
               "or tried. <b>No prior knowledge of computers is required and none is assumed.</b>", st_td),
     Paragraph("Willingness and clarity of interest only. Nobody is rejected at this stage.", st_td),
     Paragraph("\u2014", st_tdc)],

    [Paragraph("<b>2</b><br/><font size=7>Aptitude</font>", st_tdc),
     Paragraph("A thirty-minute written screening: pattern recognition, simple logic and "
               "reasoning, basic mathematics, and one short written answer on a problem in the "
               "school the applicant would like to solve. <b>Conducted on paper. No coding.</b>", st_td),
     Paragraph("Reasoning, curiosity and the ability to describe a problem clearly \u2014 not "
               "existing technical skill.", st_td),
     Paragraph("25%", st_tdc)],

    [Paragraph("<b>3</b><br/><font size=7>Make Something</font>", st_tdc),
     Paragraph("One week to produce one small thing, chosen freely from a published list: a "
               "poster, a one-page website, a Scratch animation, a working circuit, a short "
               "video, a data chart, a short program \u2014 whatever suits the applicant's chosen "
               "squad. Beginner attempts are expressly welcomed.", st_td),
     Paragraph("Effort, initiative, willingness to attempt something unfamiliar and to finish "
               "it. Polish counts for very little; completion counts for a great deal.", st_td),
     Paragraph("40%", st_tdc)],

    [Paragraph("<b>4</b><br/><font size=7>Conversation</font>", st_tdc),
     Paragraph("A five to seven minute conversation with two Core Committee members in the "
               "presence of the Faculty Advisor. The applicant explains what they made, what "
               "went wrong, and what they want to learn next.", st_td),
     Paragraph("Honesty, ability to explain, teachability, and whether the applicant can "
               "work with others.", st_td),
     Paragraph("25%", st_tdc)],

    [Paragraph("<b>5</b><br/><font size=7>Induction</font>", st_tdc),
     Paragraph("Selected students are announced on the notice board, sign the Code of Conduct "
               "together with a parent or guardian, and serve a <b>thirty-day probation</b> in "
               "which regular attendance is required.", st_td),
     Paragraph("Consistency. Confirmation of full membership follows successful probation.", st_td),
     Paragraph("10%<br/><font size=7>attendance</font>", st_tdc)],
]
F.append(table(stages, [20*mm, 68*mm, 52*mm, W-140*mm]))

F.append(Paragraph("D.2 &nbsp; Principles binding the selection", st_h1))
F.append(bullets([
    "<b>No fee of any kind</b> shall be charged for applying to, or for membership of, the club.",
    "<b>Prior experience is not a criterion.</b> A complete beginner who finishes a simple task ranks above an experienced student who submits nothing.",
    "<b>Reserved places.</b> Of every intake, not fewer than <b>40% of places shall be reserved for Classes VI to IX</b>, so that the club continually renews itself, and the club shall actively encourage applications from girl students with the aim of a balanced cohort.",
    "<b>Marks are not a gate.</b> Academic performance is not a selection criterion; only the ability to meet club commitments without harming one's studies, which the Faculty Advisor shall judge.",
    "<b>Transparency.</b> Criteria and weights are published before the intake; every unsuccessful applicant is told, on request, what would strengthen their next application, and may reapply at the next intake.",
    "<b>The Faculty Advisor holds a veto</b> over every selection and removal decision, and the Principal's decision is final in all cases.",
    "<b>Rejection is never exclusion.</b> An applicant not selected for the Core Track remains a full Open Track member and may attend every workshop the club runs.",
]))

F.append(Paragraph("D.3 &nbsp; Continuing membership and removal", st_h1))
F.append(Paragraph(
    "Core membership is renewed each term on three simple conditions: attendance of not less "
    "than 70% of sessions, completion of the term project, and satisfactory conduct. "
    "Membership may be withdrawn by the Faculty Advisor for indiscipline, misuse of school "
    "equipment or internet access, plagiarism, or any breach of the Code of Conduct \u2014 in "
    "every case after the student has been heard, and with the matter reported to the "
    "Principal.", st_body))

F.append(Paragraph("D.4 &nbsp; Code of Conduct \u2014 to be signed by every member", st_h1))
F.append(Paragraph(
    "Each selected member, together with a parent or guardian, signs the following "
    "undertaking at induction. A signed copy is retained by the Faculty Advisor.", st_sub))

coc = [
    [Paragraph("I, a member of the Maples Tech Club, undertake that \u2014", st_th)],
    [Paragraph("<b>1. My studies come first.</b> I will not allow club work to affect my "
               "attendance, homework or examinations, and I accept that the Faculty Advisor "
               "may rest me from the club at any time if my academic performance declines.", st_td)],
    [Paragraph("<b>2. I will respect school property.</b> I will use the computer laboratory, "
               "its machines, the internet connection and all equipment carefully, only for "
               "club purposes, only during permitted hours, and never without a teacher present.", st_td)],
    [Paragraph("<b>3. I will be honest in my work.</b> I will not copy another person's work "
               "and present it as mine. Where I use code, images, designs or text created by "
               "others \u2014 including anything generated by an artificial intelligence tool \u2014 "
               "I will say so clearly. I understand that presenting AI output as my own work is "
               "treated as plagiarism.", st_td)],
    [Paragraph("<b>4. I will keep the school safe online.</b> I will not share my school "
               "account password, will not attempt to access any account or system that is not "
               "mine, will not install unapproved software, and will not visit or share "
               "inappropriate, pirated or unlawful material.", st_td)],
    [Paragraph("<b>5. I will publish nothing in the school's name without approval.</b> No "
               "website change, notice, poster, photograph, video or social media post "
               "representing Maples Academy will be issued by me without the prior written "
               "approval of the Faculty Advisor.", st_td)],
    [Paragraph("<b>6. I will protect others' privacy.</b> I will not photograph, record or "
               "publish any student or teacher without their knowledge and consent, and I will "
               "not share anyone's personal data.", st_td)],
    [Paragraph("<b>7. I will teach what I learn.</b> I will help juniors and new members "
               "willingly, and I will not mock or discourage a beginner. Every member of this "
               "club started by knowing nothing.", st_td)],
    [Paragraph("<b>8. I will conduct myself with courtesy</b> towards teachers, staff, "
               "visitors and fellow students, in the club and when representing the school "
